# Copy to .env and fill in. Vite exposes only VITE_* variables to the browser.
# These values are visible to anyone who opens the site. Security comes from firestore.rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=univibe-events-9c77f.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=univibe-events-9c77f
VITE_FIREBASE_STORAGE_BUCKET=univibe-events-9c77f.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to use the local Firebase emulators (npm run emulators)
VITE_USE_EMULATORS=false

# Optional: email notifications (https://www.emailjs.com, free 200 emails/month).
# Two templates: BOOKING (ticket confirmation) and NOTICE (waitlist seats + updates). See README.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_BOOKING=
VITE_EMAILJS_TEMPLATE_NOTICE=

# Optional: dashboard helpers. Restrict both keys to your domain in their consoles.
VITE_UNSPLASH_ACCESS_KEY=
VITE_GEMINI_API_KEY=
