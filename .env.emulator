# `npm run dev:emulator`: the app against local emulators with demo data (no real Firebase needed).
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_PROJECT_ID=demo-univibe
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_USE_EMULATORS=true

# Never send real emails from local testing.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_BOOKING=
VITE_EMAILJS_TEMPLATE_NOTICE=
